// Cloudflare: one Worker serves the introduction site (apphodhod.com) and the app
// (app.apphodhod.com) from www/, which `wrangler deploy` builds first (build.command).
{
  "name": "hodhod",
  "compatibility_date": "2025-10-01",
  "main": "worker/index.js",
  "build": {
    "command": "bun run scripts/build-www.ts"
  },
  "assets": {
    "directory": "./www",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
