# Secrets of the Edge Functions. Set them in the Supabase dashboard
# (Edge Functions → Secrets) or with `supabase secrets set NAME=value`.
# This file documents the names only — never commit real values.

# --- required ---------------------------------------------------------------
AI_API_KEY=                 # secret key of the AI provider (OpenAI: starts with sk-)

# --- optional ---------------------------------------------------------------
AI_PROVIDER=openai          # openai | mistral | any other name together with AI_BASE_URL
AI_MODEL=                   # default: gpt-6-luna (openai), mistral-large-latest (mistral)
AI_BASE_URL=                # only for providers without a preset, e.g. https://example.com/v1
AI_API_STYLE=               # responses | chat  (only for providers without a preset)
ALLOWED_ORIGINS=            # e.g. https://USERNAME.github.io — empty allows any origin
AI_LIMIT_PER_MINUTE=6       # fresh generations per user per minute
AI_LIMIT_PER_DAY=80         # fresh generations per user per day
AI_LIMIT_GLOBAL_PER_DAY=400 # fresh generations for all users together per day
AI_TIMEOUT_MS=60000

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to Edge Functions automatically.
# The browser app needs only the two PUBLIC values in public/config.js.
